<?php

namespace App\Clearance;

use App\Models\Order;
use App\Models\OrderLine;
use App\Models\User;
use Dgtlss\Clearance\Persona;
use Dgtlss\Clearance\Personas as BasePersonas;
use Dgtlss\Clearance\World;

class Personas extends BasePersonas
{
    public function define(): array
    {
        return [
            Persona::guest(),
            Persona::make('customer')->user(fn () => $this->user('customer')),
            Persona::make('staff')->user(fn () => $this->user('staff'))->guard('web'),
            Persona::make('admin')->user(fn () => $this->user('admin'))->expectAll(),
        ];
    }

    public function ownership(World $world): void
    {
        $world->owns(Order::class, fn (User $owner) => Order::create(['user_id' => $owner->id]));
        $world->owns(OrderLine::class, fn (User $owner, array $parents) => OrderLine::create(['order_id' => $parents['order']->id]));
    }

    private function user(string $role): User
    {
        return User::factory()->create()->assignRole($role);
    }
}
